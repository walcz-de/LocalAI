# Generic base image for all LocalAI Python backends on ROCm 7.x.
# Build once, reuse for all 18+ backend builds — eliminates re-downloading
# amdrocm-llvm (~500MB), Rust, uv, and grpcio-tools on every backend build.
#
# Build:
#   ROCM_ARCH=gfx1151 docker build -f Dockerfile.python-rocm7-base \
#       --build-arg ROCM_ARCH=gfx1151 \
#       -t 192.168.178.127:5000/localai-python-rocm7-base:latest .
#
# Use in backend builds (build-rocm.sh already passes these):
#   docker build -f backend/Dockerfile.python \
#       --build-arg BASE_IMAGE=192.168.178.127:5000/localai-python-rocm7-base:latest \
#       --build-arg SKIP_DRIVERS=true \
#       --build-arg BUILD_TYPE=hipblas \
#       --build-arg ROCM_VERSION=7 \
#       --build-arg BACKEND=rerankers \
#       ...

ARG ROCM_ARCH=gfx1151
FROM ubuntu:24.04

ARG ROCM_ARCH
ARG UBUNTU_VERSION=2404
ENV DEBIAN_FRONTEND=noninteractive

# ── 1. System build tools ────────────────────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ccache ca-certificates espeak-ng \
        curl libssl-dev git wget git-lfs \
        unzip clang upx-ucl \
        python3-pip python-is-python3 python3-dev llvm \
        python3-venv make cmake && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages --user --upgrade pip

# ── 2. ROCm 7.x — pin Ubuntu build-toolchain so it wins over ROCm packages ──
RUN mkdir -p /etc/apt/preferences.d && \
    printf \
'Package: gcc gcc-12 gcc-13 g++ g++-12 g++-13 cpp cpp-12 cpp-13\n\
Pin: release o=Ubuntu\nPin-Priority: 1001\n\n\
Package: libhiredis-dev libhiredis1.1.0 libhiredis1.0.2\n\
Pin: release o=Ubuntu\nPin-Priority: 1001\n\n\
Package: pkgconf pkg-config dpkg-dev make\n\
Pin: release o=Ubuntu\nPin-Priority: 1001\n' \
        > /etc/apt/preferences.d/ubuntu-build-tools

RUN mkdir -p /etc/apt/keyrings && \
    apt-get update && \
    apt-get install -y --no-install-recommends wget gpg && \
    wget -qO- https://repo.amd.com/rocm/packages/gpg/rocm.gpg \
        | gpg --dearmor > /etc/apt/keyrings/amdrocm.gpg && \
    echo 'deb [arch=amd64 signed-by=/etc/apt/keyrings/amdrocm.gpg] \
https://repo.amd.com/rocm/packages/ubuntu2404 stable main' \
        > /etc/apt/sources.list.d/rocm.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends amdrocm-llvm && \
    for _arch in $(echo "${ROCM_ARCH}" | tr ',' ' '); do \
        apt-get install -y --no-install-recommends "amdrocm-core-sdk-${_arch}" || \
        echo "Note: amdrocm-core-sdk-${_arch} not available, skipping" >&2 ; \
    done && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# ── 3. dpkg/status patches — strip broken gfx stanzas so build-essential works
#   Pass 1: strip gcc/cpp/make etc. from ROCm package Conflicts fields
#   Pass 2: strip any token starting with '-' from Conflicts fields (e.g. -doc)
#   Pass 3: remove entire amdrocm-*-gfxNNNN package stanzas
RUN perl -0777 -i -pe \
      's{^(Conflicts:[^\n]*\n(?:[ \t][^\n]*\n)*)}{(my $b=$1)=~s{,?\s*(?:gcc|g\+\+|cpp|make|dpkg-dev|pkgconf|libhiredis\S*)\s*(?:\([^)]*\))?}{}gi;$b=~s{^(Conflicts:)\s*,\s*}{$1 }m;$b}mge' \
      /var/lib/dpkg/status && \
    perl -0777 -i -pe \
      's{^(Conflicts:[^\n]*\n(?:[ \t][^\n]*\n)*)}{(my $b=$1)=~s{,?\s+-\S+(?:\s*\([^)]*\))?}{}g;$b=~s{^(Conflicts:)\s*,\s*}{$1 }m;$b}mge' \
      /var/lib/dpkg/status && \
    perl -0777 -i -pe \
      's{^Package: amdrocm-\S+-gfx\d+\S*\n(?:(?!^Package:)[^\n]*\n)*}{}mg' \
      /var/lib/dpkg/status && \
    echo "dpkg patches applied"

# ── 4. ROCm symlinks + PATH ──────────────────────────────────────────────────
RUN ln -sf /opt/rocm/core-7/lib/llvm /opt/rocm/llvm && \
    ln -sf /opt/rocm/core-7/bin      /opt/rocm/bin  && \
    ln -sf /opt/rocm/core-7          /opt/rocm/hip  && \
    ln -sf /opt/rocm/core-7/lib      /opt/rocm/lib  && \
    ln -sf /opt/rocm/core-7/include  /opt/rocm/include && \
    ln -sf /opt/rocm/llvm/lib/libomp.so /usr/lib/libomp.so && \
    ldconfig

ENV PATH="/opt/rocm/bin:${PATH}"

# ── 5. uv + Rust (needed by several backends for fast Python deps) ───────────
RUN curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/usr/bin sh
ENV UV_HTTP_TIMEOUT=180 PATH="/root/.cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y

# ── 6. grpcio-tools (every Python backend uses this) ────────────────────────
RUN pip install --break-system-packages --user grpcio-tools==1.71.0 grpcio==1.71.0

LABEL org.opencontainers.image.description="LocalAI Python backend base — ROCm 7 + build tools + grpcio"
LABEL build.rocm_arch="${ROCM_ARCH}"
